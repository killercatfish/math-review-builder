 "background": [
  {
   "topic": "Fraction moves after the flip",
   "explanation": "A lot of exponent points are lost after the exponent work is done, in the plain fraction arithmetic. Multiplying fractions goes straight across. Adding or subtracting needs a common denominator. Then always reduce.",
   "steps": [
    {
     "label": "Multiply: straight across",
     "math": "\\dfrac{1}{25}\\cdot\\dfrac{1}{16}=\\dfrac{1}{\\hl{25\\cdot 16}}=\\dfrac{1}{400}",
     "caption": "Multiply the bottoms. No common denominator needed. 25 + 16 = 41 would be adding."
    },
    {
     "label": "Subtract: common denominator",
     "math": "\\dfrac{4}{9}\\,\\warn{-}\\,\\dfrac{1}{6}",
     "caption": "A minus sign means subtract. You need a common denominator first."
    },
    {
     "label": "Subtract: common denominator",
     "math": "\\dfrac{8}{18}-\\dfrac{3}{18}=\\dfrac{5}{18}",
     "caption": "LCD 18. Subtract the tops, keep the bottom."
    },
    {
     "label": "Always reduce",
     "math": "\\dfrac{12}{15}=\\dfrac{\\hl{3}\\cdot 4}{\\hl{3}\\cdot 5}=\\dfrac{4}{5}",
     "caption": "Find a common factor and cancel it."
    }
   ]
  },
  {
   "topic": "Subtracting a whole expression",
   "explanation": "When you divide powers with the same base, you subtract the whole bottom exponent. If that exponent has two terms, the minus sign hits both of them.",
   "steps": [
    {
     "label": "Keep the parentheses",
     "math": "(-k+2)\\,\\warn{-}\\,(3k+7)",
     "caption": "The minus belongs to everything in the second parentheses."
    },
    {
     "label": "Distribute the minus",
     "math": "-k+2\\,\\warn{-3k}\\,\\warn{-7}",
     "caption": "+3k becomes −3k, and +7 becomes −7."
    },
    {
     "label": "Combine like terms",
     "math": "\\hl{-k-3k}+\\hl{2-7}",
     "caption": "k terms together, numbers together."
    },
    {
     "label": "Done",
     "math": "-4k-5",
     "caption": ""
    }
   ]
  },
  {
   "topic": "Rewriting with the same base",
   "explanation": "To solve 'match the exponents' problems, both sides need the same base. Know the small powers of 2 and 3 by heart, and remember that a power to a power multiplies.",
   "steps": [
    {
     "label": "Know these",
     "math": "4=2^{2}\\quad 8=2^{3}\\quad 16=2^{4}\\quad 9=3^{2}\\quad 27=3^{3}",
     "caption": "Small powers of 2 and 3 show up constantly."
    },
    {
     "label": "Rewrite",
     "math": "27^{7}=(3^{3})^{7}",
     "caption": "Swap 27 for 3³."
    },
    {
     "label": "Power to a power: multiply",
     "math": "(3^{3})^{7}=3^{\\hl{3\\cdot 7}}=3^{21}",
     "caption": "3 · 7 = 21."
    },
    {
     "label": "Works on variable exponents too",
     "math": "9^{k-2}=(3^{2})^{k-2}=3^{\\hl{2k-4}}",
     "caption": "Multiply the whole exponent by 2."
    }
   ]
  }
 ],
